VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=
# Optional client publishable keys (hosted Checkout does not require them)
VITE_STRIPE_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Edge Function secrets for LOCAL: put these in supabase/functions/.env
# (see supabase/functions/.env.example), then restart:
#   npx supabase stop && npx supabase start
# For hosted projects: supabase secrets set STRIPE_SECRET_KEY=...
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
