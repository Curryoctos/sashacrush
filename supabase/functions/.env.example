# Local Edge Function secrets — MUST live here for `supabase start`.
# (supabase/.env is NOT loaded into Edge Functions.)
#
# After editing: npx supabase stop && npx supabase start
# Never commit real secrets. Never put these in VITE_* client env.

APP_URL=http://localhost:5173

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave v3 keys (https://dashboard.flutterwave.com → Settings → API)
# Use Secret key (FLWSECK_TEST-...), NOT Client ID / Client Secret (those are v4).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Optional email
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@sashacrush.com
